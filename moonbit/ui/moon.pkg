import {
  "Hosi121/syasou/domain",
  "Hosi121/syasou/bridge",
  "Hosi121/syasou/interop" @js,
  "Hosi121/syasou/host_dom" @dom,
  "Hosi121/syasou/host_storage" @storage,
  "Hosi121/syasou/host_date" @date,
  "moonbitlang/core/math",
  "Hosi121/syasou/host_crypto" @crypto,
  "Hosi121/syasou/view",
}

supported_targets = "+js+wasm-gc"

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "prepare_ui:prepareUi",
        "render_contract:renderContract",
        "contract_rail:RailMark",
        "contract_route:RouteMap",
        "contract_card:TicketCard",
        "contract_settings:Settings",
        "contract_landscape:Landscape",
        "contract_opening:Opening",
      ],
    },
  },
)
