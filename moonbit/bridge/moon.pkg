import {
  "Hosi121/syasou/browser",
  "Hosi121/syasou/domain",
  "mizchi/js_core" @js,
}

supported_targets = "js"

options(
  targets: {
    "journey.mbt": [ "js" ],
    "tickets.mbt": [ "js" ],
    "validation.mbt": [ "js" ],
    "browser.mbt": [ "js" ],
    "interaction.mbt": [ "js" ],
    "legacy.mbt": [ "js" ],
  },
  link: {
    "js": {
      "exports": [
        "migrate_legacy_journey:migrateLegacyJourney",
        "journey_remaining:journeyRemaining",
        "sample_tickets:sampleTickets",
        "ticket_is_back:ticketIsBack",
        "ticket_shadow_width:ticketShadowWidth",
        "ticket_resting_angle:ticketRestingAngle",
        "ticket_serial:ticketSerial",
        "begin_ticket_grip:beginTicketGrip",
        "lift_ticket:liftTicket",
        "drag_ticket:dragTicket",
        "hover_ticket:hoverTicket",
        "release_ticket:releaseTicket",
        "read_storage:readStorage",
        "write_storage:writeStorage",
        "create_sound:createSound",
        "enable_sound:enableSound",
        "disable_sound:disableSound",
        "update_sound:updateSound",
        "dispose_sound:disposeSound",
        "create_window_renderer:createWindowRenderer",
        "is_preferences:isPreferences",
        "is_journey:isJourney",
        "is_ticket:isTicket",
        "is_travel_state:isTravelState",
        "is_view:isView",
        "is_note:isNote",
        "is_stored_boolean:isStoredBoolean",
        "advance_journey:advanceJourney",
        "journey_reducer:journeyReducer",
        "restore_travel:restoreTravel",
        "travel_reducer:travelReducer",
      ],
      "format": "esm",
    },
  },
)
