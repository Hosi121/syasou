///|
fn boolean_parameters(signature : String) -> Array[Int] {
  let positions = []
  let mut depth = 0
  let mut start = signature.find("(").unwrap() + 1
  let mut index = 0
  for i = start; i < signature.length(); i = i + 1 {
    let c = signature.code_unit_at(i)
    if c == 40 || c == 91 {
      depth += 1
    }
    let last = c == 41 && depth == 0
    if last || (c == 44 && depth == 0) {
      if matches(":\\s*Bool\\s*$", signature.unsafe_substring(start~, end=i)) {
        positions.push(index)
      }
      index += 1
      start = i + 1
    }
    if last {
      break
    }
    if c == 41 || c == 93 {
      depth -= 1
    }
  }
  positions
}

///|
fn js_body(implementation : String, signature : String) -> String {
  let body = if implementation.has_prefix("#|") {
    implementation
    .split("\n")
    .map(line => {
      let line = line.trim_start().to_owned()
      let start = if line.has_prefix("#| ") { 3 } else { 2 }
      line.unsafe_substring(start~, end=line.length())
    })
    .collect()
    .join("\n")
  } else {
    captures("\"([^\"]+)\"", implementation)
    .map(found => found._get_index(1).to_string())
    .join(".")
  }
  let booleans = boolean_parameters(signature)
  if booleans.is_empty() {
    body
  } else {
    "(...args) => {" +
    booleans.map(i => "args[\{i}]=Boolean(args[\{i}]);").join("") +
    "return (" +
    body +
    ")(...args)}"
  }
}

///|
fn convert_ffi(
  source : String,
  package_name : String,
  operations : Map[String, String],
  declarations : Array[String],
) -> String {
  let pattern =
    #|(?:#cfg\(target="js"\)\s*)?((?:pub )?extern "js" fn ([\w:]+)\s*\([\s\S]*?\)\s*(?:->\s*[\s\S]*?)?=)\s*(#\|[^\n]*(?:\n[ \t]*#\|[^\n]*)*|"[^"\n]+"(?:[ \t]+"[^"\n]+")?)
  let parts = []
  let mut offset = 0
  for found in captures(pattern, source) {
    let index : Int = found._get("index").cast()
    let full = found._get_index(0).to_string()
    let signature = found._get_index(1).to_string()
    let name = found._get_index(2).to_string()
    let implementation = found._get_index(3).to_string()
    let key = package_name + "_" + name.replace_all(old="::", new="_")
    if operations.contains(key) {
      fail("Duplicate FFI " + key)
    }
    operations[key] = js_body(implementation, signature)
    declarations.push(
      signature.replace(old="extern \"js\"", new="extern \"wasm\"") +
      " \"syasou\" \"" +
      key +
      "\"",
    )
    parts.push(source.unsafe_substring(start=offset, end=index))
    parts.push("#cfg(target=\"js\")\n" + signature + "\n  " + implementation)
    offset = index + full.length()
  }
  parts.push(source.unsafe_substring(start=offset, end=source.length()))
  parts.join("")
}

///|
fn changed_text(path : String, text : String) -> Unit {
  if !exists(path) || read(path) != text {
    write_text(path, text)
  }
}

///|
fn generate_ffi() -> Map[String, String] {
  let operations : Map[String, String] = Map([])
  for package_name in entries("moonbit") {
    let folder = "moonbit/" + package_name
    if !stat(folder).is_directory() {
      continue
    }
    let package_text = read(folder + "/moon.pkg")
    if matches("supported_targets\\s*=\\s*\"js\"", package_text) {
      continue
    }
    let js_alias = if package_text.contains("@js_core") {
      "@js_core"
    } else {
      "@js"
    }
    let declarations = []
    let conversions = []
    for name in entries(folder) {
      if !name.has_suffix(".mbt") ||
        name.contains("generated") ||
        name.has_suffix("test.mbt") {
        continue
      }
      let path = folder + "/" + name
      let source = read(path)
      if package_name != "interop" {
        for
          found in captures(
            "#external\\s+(pub |priv )?type (\\w+)(?!\\w|\\[)", source,
          ) {
          if found._get_index(1).to_string() != "pub " {
            continue
          }
          let name = found._get_index(2).to_string()
          conversions.push(
            "pub impl \{js_alias}.ToJs for \{name} with fn to_js(self) -> \{js_alias}.Any = \"%identity\"\npub impl \{js_alias}.FromJs for \{name} with fn from_js(value : \{js_alias}.Any) -> \{name} = \"%identity\"\npub impl \{js_alias}.Same for \{name} with fn same(a,b) { \{js_alias}.same_host(\{js_alias}.any(a), \{js_alias}.any(b)) }",
          )
        }
      }
      changed_text(
        path,
        convert_ffi(source, package_name, operations, declarations),
      )
    }
    if !declarations.is_empty() {
      changed_text(
        folder + "/ffi_wasm.generated.mbt",
        "// Generated by moonbit/dev/ffi.mbt.\n" +
        declarations
        .map(d => "///|\n#cfg(target=\"wasm-gc\")\n" + d)
        .join("\n\n") +
        "\n",
      )
    }
    if !conversions.is_empty() {
      changed_text(
        folder + "/ffi_types.generated.mbt",
        "// Typed conversions between opaque browser references.\n" +
        conversions.map(d => "///|\n" + d).join("\n\n") +
        "\n",
      )
    }
  }
  operations
}
