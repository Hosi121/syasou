{
  "name": "syasou",
  "version": "1.0.0",
  "description": "A quiet, tactile train-window workspace.",
  "scripts": {
    "predev": "npm run build:moonbit",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:moonbit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "moon": "bash scripts/moon.sh",
    "tools": "npm run moon -- run moonbit/dev --target js --release --",
    "build:moonbit": "npm run tools -- build",
    "check:moonbit": "npm run moon -- check --deny-warn && npm run moon -- fmt --check",
    "test": "npm run build:moonbit && npm run test:moonbit && npm run test:wasm",
    "test:moonbit": "npm run moon -- test",
    "test:wasm": "node --test tests/wasm/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:mobile": "playwright test --config playwright.mobile.config.js",
    "assets:icons": "npm run tools -- icons",
    "assets:fonts": "npm run tools -- fonts",
    "assets:grain": "npm run tools -- grain"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#syasou/browser-host": "./src/generated/moonbit/browser-host.js"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "parse5": "^8.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
